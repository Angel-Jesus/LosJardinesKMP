-- Create table by region
CREATE TABLE regions (
    id              TEXT PRIMARY KEY,
    country_id      TEXT NOT NULL,
    name            TEXT NOT NULL,
    level           TEXT NOT NULL,
    CONSTRAINT fk_country
        FOREIGN KEY (country_id)
        REFERENCES countries(id)
);

