-- Schema Definitios
PRAGMA losjardines_version = 1;

-- Create Registration Table
CREATE TABLE registration(
    id INTEGER PRIMARY KEY NOT NULL ON CONFLICT REPLACE,
    collection TEXT NOT NULL,
    idFirebase TEXT NOT NULL,
    country TEXT,
    dateEnter INTEGER,
    dateExit INTEGER,
    fee REAL,
    name TEXT,
    sex TEXT,
    typeDocument TEXT,
    numberDocument TEXT,
    observation TEXT,
    reasonTravel TEXT,
    region TEXT,
    typeRoom TEXT,
    room TEXT,
    companions TEXT,
    state TEXT
);

-- Get registers
getRegistersByMonth:
SELECT * FROM registration WHERE dateEnter BETWEEN ? AND ? AND (? = '' OR numberDocument LIKE ?) ORDER BY dateEnter DESC;

-- Get register by id
getRegistrationById:
SELECT * FROM registration WHERE id = ?;

--Insert value on table
insertRegistration:
INSERT INTO registration(
    collection,
    idFirebase,
    country,
    dateEnter,
    dateExit,
    fee,
    name,
    sex,
    typeDocument,
    numberDocument,
    observation,
    reasonTravel,
    region,
    room,
    typeRoom,
    companions,
    state
) VALUES (
    :collection,
    :idFirebase,
    :country,
    :dateEnter,
    :dateExit,
    :fee,
    :name,
    :sex,
    :typeDocument,
    :numberDocument,
    :observation,
    :reasonTravel,
    :region,
    :room,
    :typeRoom,
    :companions,
    :state
);

-- update on table
updateRegistration:
UPDATE registration
SET
    collection = :collection,
    idFirebase = :idFirebase,
    country = :country,
    dateEnter = :dateEnter,
    dateExit = :dateExit,
    fee = :fee,
    name = :name,
    sex = :sex,
    typeDocument = :typeDocument,
    numberDocument = :numberDocument,
    observation = :observation,
    reasonTravel = :reasonTravel,
    region = :region,
    room = :room,
    typeRoom = :typeRoom,
    companions = :companions,
    state = :state
WHERE id = :id;

-- delete on table
deleteById:
DELETE FROM registration WHERE id = ?;

-- delete all rows on table
deleteAllRegistration:
DELETE FROM registration;

-- Create Trash Table
CREATE TABLE trash(
    id INTEGER PRIMARY KEY NOT NULL ON CONFLICT REPLACE,
    collection TEXT NOT NULL,
    idFirebase TEXT NOT NULL,
    country TEXT,
    dateEnter INTEGER,
    dateExit INTEGER,
    fee REAL,
    name TEXT,
    sex TEXT,
    typeDocument TEXT,
    numberDocument TEXT,
    observation TEXT,
    reasonTravel TEXT,
    region TEXT,
    typeRoom TEXT,
    room TEXT,
    companions TEXT,
    dateDeleted INTEGER,
    state TEXT
);

-- Insert value on trash table
insertTrash:
INSERT INTO trash(
    collection,
    idFirebase,
    country,
    dateEnter,
    dateExit,
    fee,
    name,
    sex,
    typeDocument,
    numberDocument,
    observation,
    reasonTravel,
    region,
    room,
    typeRoom,
    companions,
    dateDeleted,
    state
) VALUES (
    :collection,
    :idFirebase,
    :country,
    :dateEnter,
    :dateExit,
    :fee,
    :name,
    :sex,
    :typeDocument,
    :numberDocument,
    :observation,
    :reasonTravel,
    :region,
    :room,
    :typeRoom,
    :companions,
    :dateDeleted,
    :state
);

-- Create Reservation Table
CREATE TABLE reservation(
    id INTEGER PRIMARY KEY NOT NULL ON CONFLICT REPLACE,
    collection TEXT NOT NULL,
    idFirebase TEXT NOT NULL,
    country TEXT,
    dateEnter INTEGER,
    dateExit INTEGER,
    fee REAL,
    name TEXT,
    sex TEXT,
    typeDocument TEXT,
    numberDocument TEXT,
    observation TEXT,
    region TEXT,
    typeRoom TEXT,
    room TEXT,
    companions TEXT,
    state TEXT,
    attentionState TEXT
);

-- Get reservations by state, newest first, paginated
getReservationsByState:
SELECT * FROM reservation WHERE attentionState = :attentionState ORDER BY dateEnter DESC LIMIT :limit OFFSET :offset;

-- Get reservation by id
getReservationById:
SELECT * FROM reservation WHERE id = ?;

-- Insert value on reservation table
insertReservation:
INSERT INTO reservation(
    collection,
    idFirebase,
    country,
    dateEnter,
    dateExit,
    fee,
    name,
    sex,
    typeDocument,
    numberDocument,
    observation,
    region,
    room,
    typeRoom,
    companions,
    state,
    attentionState
) VALUES (
    :collection,
    :idFirebase,
    :country,
    :dateEnter,
    :dateExit,
    :fee,
    :name,
    :sex,
    :typeDocument,
    :numberDocument,
    :observation,
    :region,
    :room,
    :typeRoom,
    :companions,
    :state,
    :attentionState
);

-- update reservation attention state (check-in) and its sync state
updateReservationAttentionState:
UPDATE reservation SET attentionState = :attentionState, state = :state WHERE id = :id;

-- delete reservation on table
deleteReservationById:
DELETE FROM reservation WHERE id = ?;

-- delete all rows on reservation table
deleteAllReservations:
DELETE FROM reservation;

